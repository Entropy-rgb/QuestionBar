{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuestionBar",
  "version": "0.1.0",
  "identifier": "dev.somesh.questionbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "QuestionBar",
        "width": 420,
        "height": 800,
        "minWidth": 280,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "A hotkey side panel for the questions you have while learning",
    "longDescription": "Press Super+` to open a panel on the right edge of the screen, type the question you just had, and get back to learning. Answer it later in Markdown with code, math and images. Questions are stored as plain Markdown files, one per topic.",
    "homepage": "https://github.com/Entropy-rgb/QuestionBar",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4ODIwMzU1REFGM0UxQjgKUldTNDRmUGFWUU9DcU83eFJyamxvbHF5ZGtncVBKTFRFaWppNHlIUDF5WTRqb1UvOFFMczgvU2YK",
      "endpoints": [
        "https://github.com/Entropy-rgb/QuestionBar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
