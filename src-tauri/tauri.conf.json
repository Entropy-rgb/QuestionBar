{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuestionBar",
  "version": "0.1.0",
  "identifier": "dev.somesh.questionbar",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "QuestionBar",
        "width": 420,
        "height": 800,
        "minWidth": 280,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
